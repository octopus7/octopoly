{
  "name": "octopoly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.18.0",
    "npm": "11.18.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "ci": "npm run typecheck && npm run test && vite build && node scripts/verify-baseline.mjs dist",
    "verify:core": "node scripts/verify-core.mjs",
    "verify:ipad": "node scripts/verify-ipad.mjs",
    "verify:ipad:physical": "node scripts/verify-ipad.mjs --require-physical",
    "verify:optional": "node scripts/verify-optional.mjs",
    "verify:optional:desktop": "node scripts/verify-optional.mjs --require-desktop",
    "verify:optional:physical": "node scripts/verify-optional.mjs --require-physical",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
